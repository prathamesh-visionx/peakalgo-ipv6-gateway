# Optional installer answers. Store your real file outside the release ZIP, root-only (chmod 600).
# Values are parsed literally, not executed as shell code.
BACKEND_BASE_URL=https://api.example.com
BACKEND_ALLOWED_CIDRS=203.0.113.10/32
# Same random token (32+ characters) configured in the AWS backend environment.
# Omit this to enter it securely when registration is reviewed.
EGRESS_REGISTRATION_TOKEN=
# Normally discovered from the droplet. Override only after checking the DO dashboard.
# PUBLIC_IPV4=
# PRIMARY_IPV6=
# PUBLIC_INTERFACE=
# NETPLAN_ID=
# SSH_PORTS=22
